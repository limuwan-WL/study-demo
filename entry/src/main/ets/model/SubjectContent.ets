// ==================== 学科课程内容数据源 ====================
// 按「学科|年级（或分册/方向）」组织每个学科模块下的真实课程主题。
// 维护方式：
//   1. key = `${subjectId}|${f1}`，f1 必须是 SubjectModel 中该学科的年级/分册/方向名称；
//   2. ContentUnit.module 必须与该学科 modules 中的模块名一致；
//   3. 新增内容只需在对应 key 下追加 u(...)，页面会自动按模块筛选展示。

export class ContentUnit {
  module: string = ''
  topics: string[] = []

  constructor(module: string, topics: string[]) {
    this.module = module
    this.topics = topics
  }
}

function u(module: string, t1: string, t2: string, t3: string): ContentUnit {
  return new ContentUnit(module, [t1, t2, t3])
}

